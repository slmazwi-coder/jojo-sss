# Copy to .env.local and fill in real values. Never commit the filled-in file.
# The anon key is safe for the browser only because Row Level Security restricts
# what it can do. Never expose the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chatbot (optional). The build also accepts GEMINI_API_KEY via vite.config.ts
# define; VITE_GEMINI_API_KEY is the preferred name.
VITE_GEMINI_API_KEY=